# Environment variables for production
# Copy this file to .env.prod and fill in your values

# Your domain name (without protocol)
DOMAIN=campusbites.com

# Email for Let's Encrypt certificates
ACME_EMAIL=admin@campusbites.com

# Basic auth for Traefik dashboard
# Generate with: echo $(htpasswd -nb admin password) | sed -e s/\\$/\\$\\$/g
# Example below uses admin:password (change this!)
TRAEFIK_AUTH=admin:$$2y$$10$$7Z7z7Z7z7Z7z7Z7z7Z7z7eO7Z7z7Z7z7Z7z7Z7z7Z7z7Z7z7Z7

# Next.js environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
